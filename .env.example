# ── Required ──────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk-your-groq-key-here

# ── Optional — defaults shown ─────────────────────────────────────────────
# Redis URL (omit to use in-memory fallback — single-worker dev only)
REDIS_URL=redis://redis:6379/0

# Session lifetime in seconds (default 1 hour)
SESSION_TTL_SECONDS=3600

# Insight cache TTL in seconds (default 1 hour)
CACHE_TTL_SECONDS=3600

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:8501

# FastAPI backend URL as seen by the Streamlit frontend
API_BASE_URL=http://localhost:8000/api

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
