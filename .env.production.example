# Production Environment Variables Template
# Copy this as a reference when setting up on Render, Fly.io, Heroku, etc.
# DO NOT commit secrets to GitHub!

# ── REQUIRED ──────────────────────────────────────────────────────────────
# Get free key at https://console.groq.com
GROQ_API_KEY=gsk-your-production-key-here

# ── OPTIONAL ──────────────────────────────────────────────────────────────
# For production with Redis persistence
# Example: redis://default:password@redis-12345.c123.us-east-1-2.ec2.cloud.redislabs.com:6379
# Leave empty to use in-memory storage (fine for small deployments)
REDIS_URL=redis://localhost:6379/0

# Session & Cache Settings
SESSION_TTL_SECONDS=3600
CACHE_TTL_SECONDS=3600

# Logging
LOG_LEVEL=INFO

# Optional: for monitoring
# SENTRY_DSN=your-sentry-dsn-here
